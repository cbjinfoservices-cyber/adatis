# Copier en .env (jamais dans git) : cp env.example .env

# Port publié sur l'hôte. 127.0.0.1 = accès local uniquement ; 0.0.0.0 pour
# l'ouvrir au réseau (placer alors un reverse proxy HTTPS devant).
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# URL publique du portail (retour OAuth). Doit refléter HTTP_PORT / le domaine.
PORTAL_URL=http://localhost:8080

# --- Base de données (mot de passe sans caractères spéciaux : openssl rand -hex 24)
DB_NAME=asp_portal
DB_USER=asp
DB_PASSWORD=

# --- Mode ----------------------------------------------------------------
# development : HTTP autorisé, portail ouvert si AUTH_MODE=disabled (tests).
# production  : exige HTTPS devant le portail (PORTAL_URL en https://, COOKIE_SECURE=true),
#               le SSO Ascender, TOKEN_ENCRYPTION_KEY et PostgreSQL en TLS (non fourni
#               par ce compose : utiliser Kubernetes — deploy/README.md).
NODE_ENV=development
COOKIE_SECURE=false

# --- SSO Ascender (AUTH_MODE=awx pour l'activer) ---------------------------
AUTH_MODE=disabled
AWX_BASE_URL=
AWX_CLIENT_ID=
AWX_CLIENT_SECRET=
AWX_REDIRECT_URI=
AWX_ADMIN_USERS=
# 32 octets en base64 : openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=30
ALLOWED_ORIGINS=
CONNECTOR_ALLOWED_HOSTS=

# --- Alertes email (SMTP interne) -----------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
