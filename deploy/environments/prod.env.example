# Profil prod. Copier en prod.env (ignoré par Git) puis renseigner les valeurs vides.
# Format : CLE=valeur, une par ligne. Commentaires uniquement en début de ligne.
# prod ne se déploie qu'en Kubernetes (--target k8s) : Compose n'assure pas le TLS PostgreSQL.

APP_ENV=prod

# --- Commun (HTTPS obligatoire, SSO Ascender obligatoire) -----------------
PORTAL_URL=https://portal.acme.fr
NODE_ENV=production
COOKIE_SECURE=true
AUTH_MODE=awx
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=30
# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
ALLOWED_ORIGINS=
CONNECTOR_ALLOWED_HOSTS=

# --- SSO Ascender ---------------------------------------------------------
AWX_BASE_URL=https://awx.acme.fr
AWX_CLIENT_ID=
AWX_CLIENT_SECRET=
AWX_REDIRECT_URI=
AWX_ADMIN_USERS=

# --- Alertes email --------------------------------------------------------
SMTP_HOST=smtp.acme.fr
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=asp@acme.fr

# --- Kubernetes (deploy/deploy.sh) ----------------------------------------
# Cluster dédié à la production : le contexte doit correspondre à KUBE_CONTEXT.
KUBE_CONTEXT=
REGISTRY=registry.acme.fr/asp
TAG=
DOMAIN=portal.acme.fr
LETSENCRYPT_EMAIL=ops@acme.fr
CERT_MANAGER_ISSUER=
TLS_CERT_FILE=
TLS_KEY_FILE=
ASCENDER_CA_FILE=
API_EGRESS_CIDR=
# Obligatoire en prod : CIDR restreint aux réseaux Ascender, SMTP et connecteurs.
INGRESS_NAMESPACE=
