# Profil staging. Copier en staging.env (ignoré par Git) puis renseigner les valeurs vides.
# Format : CLE=valeur, une par ligne. Commentaires uniquement en début de ligne.

APP_ENV=staging

# --- Commun (HTTPS obligatoire, SSO Ascender obligatoire) -----------------
PORTAL_URL=https://portal-staging.acme.fr
NODE_ENV=production
COOKIE_SECURE=true
AUTH_MODE=awx
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=30
# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
ALLOWED_ORIGINS=
CONNECTOR_ALLOWED_HOSTS=

# --- SSO Ascender ---------------------------------------------------------
AWX_BASE_URL=https://awx-staging.acme.fr
AWX_CLIENT_ID=
AWX_CLIENT_SECRET=
AWX_REDIRECT_URI=
AWX_ADMIN_USERS=

# --- Alertes email --------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# --- Docker Compose (derrière un reverse proxy HTTPS) ---------------------
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
DB_NAME=asp_portal
DB_USER=asp
DB_PASSWORD=

# --- Kubernetes (deploy/deploy.sh) ----------------------------------------
# Un cluster dédié à staging : le contexte doit correspondre à KUBE_CONTEXT.
KUBE_CONTEXT=
REGISTRY=registry.acme.fr/asp
TAG=
DOMAIN=portal-staging.acme.fr
LETSENCRYPT_EMAIL=ops@acme.fr
LETSENCRYPT_STAGING=true
CERT_MANAGER_ISSUER=
TLS_CERT_FILE=
TLS_KEY_FILE=
ASCENDER_CA_FILE=
API_EGRESS_CIDR=
INGRESS_NAMESPACE=
