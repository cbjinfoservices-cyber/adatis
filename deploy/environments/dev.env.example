# Profil dev. Copier en dev.env (ignoré par Git) puis renseigner les valeurs vides.
# Format : CLE=valeur, une par ligne. Commentaires uniquement en début de ligne.

APP_ENV=dev

# --- Commun ---------------------------------------------------------------
PORTAL_URL=http://localhost:8080
NODE_ENV=development
COOKIE_SECURE=false
AUTH_MODE=disabled
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=30
TOKEN_ENCRYPTION_KEY=
ALLOWED_ORIGINS=
CONNECTOR_ALLOWED_HOSTS=

# --- SSO Ascender (requis par deploy/deploy.sh ; AUTH_MODE=awx pour l'activer en compose)
AWX_BASE_URL=
AWX_CLIENT_ID=
AWX_CLIENT_SECRET=
AWX_REDIRECT_URI=
AWX_ADMIN_USERS=

# --- Docker Compose -------------------------------------------------------
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
DB_NAME=asp_portal
DB_USER=asp
DB_PASSWORD=

# --- Kubernetes (deploy/deploy.sh) ----------------------------------------
KUBE_CONTEXT=
REGISTRY=
TAG=dev
DOMAIN=
