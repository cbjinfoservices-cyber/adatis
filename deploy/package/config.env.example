# =============================================================================
# Configuration du déploiement — copier en config.env puis renseigner.
# Toutes les variables reconnues sont décrites dans deploy/deploy.sh --help.
# config.env contient des secrets : droits 600, jamais dans git.
# =============================================================================

# Accès au cluster : chemin du kubeconfig fourni par l'administrateur.
# Vide = ~/.kube/config, sinon celui du nœud k3s / microk8s s'il y en a un.
KUBECONFIG=

# VM vierge : installation de k3s embarqué (auto = si aucun cluster n'est
# configuré sur la machine ; true / false pour forcer). Options k3s en plus.
K3S_INSTALL=auto
K3S_EXTRA_ARGS=

# Registre d'images (cluster multi-nœuds). Vide = import sur le nœud local.
REGISTRY=

NAMESPACE=asp-portal

# Domaine public : active l'Ingress, HTTPS obligatoire (une source ci-dessous)
DOMAIN=
LETSENCRYPT_EMAIL=
CERT_MANAGER_ISSUER=
TLS_CERT_FILE=
TLS_KEY_FILE=
# Sans autorité de certification : certificat auto-signé généré (tests,
# réseau interne ; les navigateurs afficheront un avertissement)
TLS_SELF_SIGNED=false

# SSO Ascender — obligatoire (l'API refuse de démarrer sans)
AWX_BASE_URL=https://
AWX_CLIENT_ID=
AWX_CLIENT_SECRET=
AWX_ADMIN_USERS=
# Autorité interne qui signe le certificat d'Ascender (fichier PEM)
ASCENDER_CA_FILE=

# Sessions : expiration après inactivité (minutes) et durée maximale (heures)
SESSION_IDLE_MINUTES=30
SESSION_TTL_HOURS=12

# Réseau : namespace du contrôleur Ingress (vide = détecté) et réseau
# joignable par l'API (Ascender, SMTP, connecteurs). Restreindre si possible.
INGRESS_NAMESPACE=
API_EGRESS_CIDR=0.0.0.0/0
# Hôtes que le test de connecteur peut appeler (vide = test désactivé)
CONNECTOR_ALLOWED_HOSTS=

# Alertes email par SMTP interne (TLS obligatoire)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
