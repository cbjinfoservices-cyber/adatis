{
  // Vérification de types du JavaScript de l'API (JSDoc), sans compilation :
  // Node exécute toujours les fichiers .js tels quels. Types partagés : src/types.d.ts.
  "compilerOptions": {
    "target": "ES2023",
    "module": "node16",
    "moduleResolution": "node16",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    // Étape suivante : "strict": true, une fois les paramètres annotés en JSDoc.
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src", "scripts", "testing", "test"]
}
