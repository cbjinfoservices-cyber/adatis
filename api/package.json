{
  "name": "asp-portal-api",
  "version": "1.0.0",
  "private": true,
  "description": "API REST du portail ASP — seule porte d'accès à PostgreSQL",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1",
    "type-check": "tsc -p .",
    "rotate-keys": "node scripts/rotate-keys.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "compression": "1.8.2",
    "cors": "2.8.5",
    "express": "4.22.3",
    "express-rate-limit": "7.5.0",
    "helmet": "8.1.0",
    "nodemailer": "10.1.7",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@electric-sql/pglite-socket": "^0.2.14",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "typescript": "~5.8.3"
  }
}
